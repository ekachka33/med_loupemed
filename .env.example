# .env.example
# Этот файл является примером конфигурации переменных окружения.
# Создайте файл .env в этой же директории и скопируйте в него содержимое этого файла,
# заполнив реальными значениями.

# Django settings
SECRET_KEY=your_django_secret_key_here
DEBUG=1
ALLOWED_HOSTS='localhost,127.0.0.1,[::1],web,yourdomain.com'

# Database settings (PostgreSQL)
POSTGRES_DB=your_db_name
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_HOST=db # Service name in docker-compose.yml
POSTGRES_PORT=5432

# Email settings (for GMail SMTP)
EMAIL_HOST_USER=your_gmail_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password # Use an app password for security!
DEFAULT_FROM_EMAIL=your_clinic_email@example.com
CONTACT_FORM_RECIPIENT_EMAIL=admin_recipient_email@example.com